# Template for the reviewed M4.5 closed-acceptance edge.
# Replace __KENATO_HOSTNAME__ with the dedicated DNS hostname only after a
# publicly trusted certificate has been issued for that exact name.

limit_req_zone $binary_remote_addr zone=kenato_http_per_ip:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=kenato_ws_per_ip:10m rate=12r/m;
limit_conn_zone $binary_remote_addr zone=kenato_conn_per_ip:10m;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name __KENATO_HOSTNAME__;

    server_tokens off;
    access_log off;

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __KENATO_HOSTNAME__;

    ssl_certificate /etc/letsencrypt/live/__KENATO_HOSTNAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__KENATO_HOSTNAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:KENATO_SSL:10m;
    ssl_session_timeout 1d;

    server_tokens off;
    client_max_body_size 128k;
    access_log off;
    error_log /var/log/nginx/kenato-error.log warn;

    location = /v1/messaging/ws {
        limit_req zone=kenato_ws_per_ip burst=4 nodelay;
        limit_conn kenato_conn_per_ip 4;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # The Go service does not use client-IP forwarding for identity or auth.
        # Keep the deployment contract explicit rather than introducing a future
        # accidental trust dependency on proxy-provided addresses.
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }

    location / {
        limit_req zone=kenato_http_per_ip burst=30 nodelay;
        limit_conn kenato_conn_per_ip 16;

        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Real-IP "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
        proxy_buffering off;
    }
}
